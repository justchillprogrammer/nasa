{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "services": {
    "sky-blink": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api/index.py",
      "buildCommand": "pip install -r backend/requirements.txt",
      "functions": {
        "api/index.py": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "sky-blink" }
    }
  ]
}
